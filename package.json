{
  "name": "uconvert",
  "version": "0.1.2",
  "description": "",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "example": "npm run build && node example/run.mjs",
    "example:cjs": "node example/run.cjs",
    "format": "prettier --write .",
    "postinstall": "husky",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewTkachuk42/uconvert.git"
  },
  "keywords": [
    "unit-conversion",
    "unit-converter",
    "convert-units",
    "measurement",
    "measurements",
    "unit-system",
    "metric",
    "imperial",
    "si-units",
    "length",
    "distance",
    "height",
    "weight",
    "mass",
    "speed",
    "feet",
    "inches",
    "feet-inches",
    "centimeters",
    "meters",
    "kilometers",
    "miles",
    "typescript",
    "javascript",
    "utility",
    "math",
    "precision",
    "cross-units"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/AndrewTkachuk42/uconvert/issues"
  },
  "homepage": "https://github.com/AndrewTkachuk42/uconvert#readme",
  "overrides": {
    "minimatch": "^10.2.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.4.6",
    "prettier-plugin-organize-imports": "^4.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
