#!/usr/bin/env sh

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

echo ""
echo "${BLUE}╔════════════════════════════════════════╗${NC}"
echo "${BLUE}║     Running Pre-Commit Checks         ║${NC}"
echo "${BLUE}╚════════════════════════════════════════╝${NC}"
echo ""

# Run linting hook
sh .husky/pre-commit-lint
LINT_EXIT_CODE=$?

if [ $LINT_EXIT_CODE -ne 0 ]; then
  exit $LINT_EXIT_CODE
fi

# Run Jest tests
sh .husky/pre-commit-test
TEST_EXIT_CODE=$?

if [ $TEST_EXIT_CODE -ne 0 ]; then
  exit $TEST_EXIT_CODE
fi

echo "${GREEN}✨ All checks passed${NC}"
exit 0