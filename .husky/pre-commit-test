#!/usr/bin/env sh

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

echo "${YELLOW}🧪 Running Jest tests...${NC}"

if ! npm run test; then
  echo "${RED}❌ Tests failed. Please fix the failing tests above.${NC}"
  exit 1
fi

echo "${GREEN}✅ All tests passed${NC}"
exit 0
